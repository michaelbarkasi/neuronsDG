% Hand-maintained (not roxygen2-generated: there is no corresponding
% documented object in R/ for an Rcpp Modules reference class, so roxygen2
% has nothing to tag this with). Edit this file directly.
\name{Rcpp_neuron-class}
\docType{class}
\alias{Rcpp_neuron-class}
\alias{Rcpp_neuron}
\title{The neuron reference class}
\description{
\code{Rcpp_neuron} is the S4 reference class that Rcpp Modules generates for
every neuron object (its parent class, \code{\link[=C++Object-class]{C++Object}},
is likewise generated by Rcpp itself and is not specific to this package).
Users should never call \code{new("Rcpp_neuron", ...)} directly; construct
neuron objects with \code{\link{new.neuron}} or
\code{\link{load.rasters.as.neurons}} instead, and see
\code{\link{neuron-methods}} for the \code{print}/\code{summary}/\code{plot}
methods defined on this class.
}
